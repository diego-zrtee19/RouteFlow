# RouteFlow - Environment Variables Configuration

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# DHL Express API (Sandbox / Production)
# Get credentials from: https://developer.dhl.com/
DHL_API_KEY=your_dhl_api_key
DHL_API_SECRET=your_dhl_api_secret
DHL_ACCOUNT_NUMBER=your_dhl_account_number
# Test environment: https://express.api.dhl.com/mydhlapi/test
# Production environment: https://express.api.dhl.com/mydhlapi
DHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test

# FedEx API (Sandbox / Production)
# Get credentials from: https://developer.fedex.com/
FEDEX_CLIENT_ID=your_fedex_client_id
FEDEX_CLIENT_SECRET=your_fedex_client_secret
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
# Test environment: https://apis-sandbox.fedex.com
# Production environment: https://apis.fedex.com
FEDEX_BASE_URL=https://apis-sandbox.fedex.com

# Uber Direct API (Local Delivery)
UBER_CUSTOMER_ID=your_uber_customer_id
UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret
UBER_API_URL=https://api.uber.com/v1/customers

# Supabase — the system of record for sellers, products, purchase links,
# orders, payments, shipments, disputes and events.
#
# Apply supabase_schema_v3.sql in the Supabase SQL Editor BEFORE using the app.
# Check the connection with: GET /api/health/supabase
#
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
#   URL            Supabase Dashboard > Project Settings > API > Project URL.
#                  Must be https://<20-char-lowercase-ref>.supabase.co
#   ANON_KEY       The "anon" / "publishable" key. Browser-safe, RLS-limited.
#   SERVICE_ROLE   The "service_role" / "secret" key.
#                  SERVER-ONLY: it bypasses RLS. Never prefix it NEXT_PUBLIC_,
#                  never import it in a client component, never log it.
#
# Status values reported by /api/health/supabase:
#   NOT_CONFIGURED  variable absent
#   CONFIGURED      present and well-formed, not yet contacted
#   CONNECTED       reachable, schema present, query succeeded
#   ERROR           see the `reason` field (dns_failure, project_paused, ...)
#
# NOTE: without SUPABASE_SERVICE_ROLE_KEY the API routes that write data
# (dashboard, orders, shipments) return 503. This is deliberate: the previous
# in-memory fallback is what allowed the seller-fallback vulnerability.

# Clerk Authentication (Optional for User Sessions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Scheduled server operations. Generate a strong random secret; never expose to the browser.
CRON_SECRET=
# Preview by default. Delivery also requires a live Stripe environment and verified sender.
ROUTEFLOW_EMAIL_DELIVERY=preview
RESEND_API_KEY=
ROUTEFLOW_EMAIL_FROM=
# Enable only after Connect, delivery, refunds and production accounts have been validated.
ROUTEFLOW_LIVE_SETTLEMENTS=false
ROUTEFLOW_PRODUCTION_PROJECT_REF=
ROUTEFLOW_PRODUCTION_DATABASE_URL=

